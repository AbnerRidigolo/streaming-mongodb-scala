# =============================================================================
# Real-time Streaming Pipeline — Olist :: environment variables
# Copy to `.env` and adjust as needed:  cp .env.example .env
# =============================================================================

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_GROUP_ID=spark-streaming-pipeline

# ---- Topics ----
TOPIC_ORDERS_RAW=orders-raw
TOPIC_PAYMENTS_RAW=payments-raw
TOPIC_DELIVERY=delivery-events
TOPIC_ORDERS_ENRICHED=orders-enriched
TOPIC_ORDER_STATUS=order-status
TOPIC_ORDER_ALERTS=order-alerts

# ---- Spark ----
SPARK_ENV=local
CHECKPOINT_LOCATION=/tmp/streaming-checkpoints
SPARK_LOG_LEVEL=WARN

# ---- Delta Lake paths ----
BRONZE_PATH=data/bronze/orders
SILVER_PATH=data/silver/orders_enriched
GOLD_PATH=data/gold/orders_agg
CUSTOMERS_PATH=data/reference/customers

# ---- Producers ----
EVENTS_PER_SECOND=10
PRODUCER_ID=orders-producer-001
CANCELLATION_RATE=0.12
DATA_DIR=data/raw

# ---- MongoDB (serving layer) ----
# Required by docker compose. Never commit values: run scripts/gen_env.sh to
# fill these with random passwords in .env (git-ignored).
MONGO_ROOT_PASSWORD=
MONGO_CONNECT_PASSWORD=
MONGO_DASHBOARD_PASSWORD=
MONGO_SPARK_PASSWORD=
# Host port of the MongoDB container (default 27018; 27017 is often taken by a
# local MongoDB).
# MONGO_HOST_PORT=27018

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARD_PORT=8501
PRODUCER_METRICS_PORT=8000
