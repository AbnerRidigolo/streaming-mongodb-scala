# syntax=docker/dockerfile:1
# Cloud producer (Azure Container Apps Job, Phase 5). Build context: repo root.
# Generates the synthetic Olist sample at start, then replays orders and
# deliveries once. Kafka endpoint, auth and value format come from the
# environment (KAFKA_CFG_*, VALUE_FORMAT), like the local producers.
FROM python:3.11-slim-bookworm

WORKDIR /app

RUN pip install --no-cache-dir \
    "confluent-kafka[avro,schemaregistry]==2.3.0" \
    "requests==2.31.0" \
    "fastavro==1.9.4" \
    "structlog==23.2.0" \
    "prometheus-client==0.19.0" \
    "pandas==2.1.4" \
    "pyarrow==14.0.2"

COPY producers/ /app/producers/
COPY scripts/seed_data.py scripts/cloud_producer.sh /app/scripts/

RUN useradd --system --uid 10001 app
USER app

ENV VALUE_FORMAT=json PRODUCER_LOOP=false PYTHONUNBUFFERED=1
ENTRYPOINT ["sh", "/app/scripts/cloud_producer.sh"]
